# Copiá este archivo a `.env` y completá los valores.
# Dashboard de Supabase → Settings → API
#
# Ambas son públicas por diseño: viajan al navegador dentro del bundle.
# Lo que protege los datos son las policies de RLS, no el secreto de la key.
#
# La service_role key NO va acá ni en ningún archivo del repo: solo como
# secret de Edge Function (`supabase secrets set`).

VITE_SUPABASE_URL=https://jsnfdeztgefaeshvottd.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Solo en el dashboard de Edge Functions (nunca en Vite) ---
# supabase functions deploy extract-news --project-ref jsnfdeztgefaeshvottd
# supabase functions deploy notify-listing --project-ref jsnfdeztgefaeshvottd
# supabase secrets set RESEND_API_KEY=re_... ADMIN_NOTIFY_EMAIL=tu@mail.com PUBLIC_SITE_URL=https://... RESEND_FROM="Mercado Chino Auto <onboarding@resend.dev>" --project-ref jsnfdeztgefaeshvottd
#
# RESEND_API_KEY     mail transaccional (si falta, notify-listing responde 200 skipped)
# ADMIN_NOTIFY_EMAIL destino del aviso cuando entra una solicitud
# PUBLIC_SITE_URL    links del mail hacia /admin/publicaciones
# RESEND_FROM        opcional; por defecto el sandbox de Resend
